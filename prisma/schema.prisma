generator client {
  provider        = "prisma-client-js"
  output          = "../generated/prisma"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
}

// ─── Institutions ────────────────────────────────────────────────────────────

model University {
  id           String   @id @default(cuid())
  oid          String   @unique
  name         String
  description  String?
  nameMultilingual    Json?
  descriptionMultilingual Json?
  logoUrl      String?
  type         String // "yo" | "amk" | "amm"
  municipality String?
  website      String?
  email        String?
  studentCount Int?
  syncedAt     DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  programs  ProgramUniversity[]
  locations UniversityLocation[]

  usersSaved UserUniversity[]

  @@index([type])
  @@index([syncedAt])
}

model UniversityLocation {
  id           String     @id @default(cuid())
  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  code         String // kunta_091
  name         String // Helsinki

  @@unique([universityId, code])
}

// ─── Programmes ──────────────────────────────────────────────────────────────

model Program {
  id              String   @id @default(cuid())
  oid             String   @unique
  name            String
  description     String?
  type            String // "yo" | "amk" | "amm"
  typePath        String? // "kk/yo"
  isDegree        Boolean  @default(false)
  imageUrl        String?
  creditsAmount   Float?
  creditsUnit     String? // "ECTS credits"
  eqfLevel        String? // "eqf_8"
  nqfLevel        String? // "nqf_8"
  fieldOfStudy    String? // first koulutusala name (English)
  degreeTitles    String[] // tutkintonimike names (English)
  teachingLanguages String[] // kielivalinta e.g. ["en", "fi"]
  implementations Json? // resolved toteutukset (English only)
  syncedAt        DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  universities     ProgramUniversity[]
  userPrograms     UserProgram[]
  mockTests        MockTest[]
  guidanceSections GuidanceSection[]

  @@index([type])
  @@index([isDegree])
  @@index([syncedAt])
}

// Many-to-many join table
model ProgramUniversity {
  programId    String
  universityId String
  program      Program    @relation(fields: [programId], references: [id], onDelete: Cascade)
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@id([programId, universityId])
}

// ─── Guidance Content ────────────────────────────────────────────────────────

model GuidanceSection {
  id         String   @id @default(cuid())
  programOid String
  program    Program  @relation(fields: [programOid], references: [oid], onDelete: Cascade)
  key        String
  title      String
  body       String
  order      Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([programOid, key])
  @@index([programOid])
}

enum Role {
  USER
  ADMIN
}

// ─── Users & Auth ────────────────────────────────────────────────────────────

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  firstName       String?
  lastName        String?
  role            Role      @default(USER)
  hasTestAccess   Boolean   @default(false)
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Email verification
  emailVerifyToken     String?
  emailVerifyExpiresAt DateTime?

  // Password reset
  resetToken           String?
  resetTokenExpiresAt  DateTime?

  auth              Auth?
  mockTests         MockTest[]
  savedPrograms     UserProgram[]
  savedUniversities UserUniversity[]
}

model Auth {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String   // SHA-256 of the issued token; never store plaintext
  createdAt        DateTime @default(now())
  expiresAt        DateTime
}

// ─── User Saved Items ─────────────────────────────────────────────────────────

model UserProgram {
  id        String   @id @default(cuid())
  userId    String
  programId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  program   Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  status    String?
  createdAt DateTime @default(now())

  @@unique([userId, programId])
}

model UserUniversity {
  id           String     @id @default(cuid())
  userId       String
  universityId String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  notes        String?
  createdAt    DateTime   @default(now())

  @@unique([userId, universityId])
}

// ─── Mock Tests ───────────────────────────────────────────────────────────────

model TestTemplate {
  id              String     @id @default(cuid())
  title           String
  description     String?
  subject         String     // "math", "language_en", "reading", "analytical"
  durationMinutes Int
  isActive        Boolean    @default(false)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  questions       Question[]
  mockTests       MockTest[]

  @@index([subject])
  @@index([isActive])
}

model Question {
  id          String           @id @default(cuid())
  templateId  String
  template    TestTemplate     @relation(fields: [templateId], references: [id], onDelete: Cascade)
  body        String
  type        String           @default("multiple_choice")
  points      Int              @default(1)
  orderIndex  Int
  explanation String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  options     AnswerOption[]
  userAnswers MockTestAnswer[]

  @@index([templateId])
}

model AnswerOption {
  id          String           @id @default(cuid())
  questionId  String
  question    Question         @relation(fields: [questionId], references: [id], onDelete: Cascade)
  label       String           // "A", "B", "C", "D"
  body        String
  isCorrect   Boolean          @default(false)
  orderIndex  Int
  createdAt   DateTime         @default(now())
  userAnswers MockTestAnswer[]

  @@index([questionId])
}

model MockTest {
  id               String           @id @default(cuid())
  userId           String
  programId        String?
  templateId       String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  program          Program?         @relation(fields: [programId], references: [id], onDelete: Cascade)
  template         TestTemplate     @relation(fields: [templateId], references: [id])
  score            Int?
  maxScore         Int?
  timeTakenMinutes Int?
  status           String           @default("in_progress")
  completedAt      DateTime?
  createdAt        DateTime         @default(now())
  answers          MockTestAnswer[]

  @@index([userId])
  @@index([templateId])
  @@index([status])
}

model MockTestAnswer {
  id               String        @id @default(cuid())
  mockTestId       String
  mockTest         MockTest      @relation(fields: [mockTestId], references: [id], onDelete: Cascade)
  questionId       String
  question         Question      @relation(fields: [questionId], references: [id])
  selectedOptionId String?
  selectedOption   AnswerOption? @relation(fields: [selectedOptionId], references: [id])
  isCorrect        Boolean?
  pointsAwarded    Int           @default(0)
  createdAt        DateTime      @default(now())

  @@unique([mockTestId, questionId])
  @@index([mockTestId])
}
